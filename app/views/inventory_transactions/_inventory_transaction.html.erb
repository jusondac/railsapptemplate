<div id="<%= dom_id inventory_transaction %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Product:</strong>
    <%= inventory_transaction.product_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Quantity change:</strong>
    <%= inventory_transaction.quantity_change %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Transaction type:</strong>
    <%= inventory_transaction.transaction_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= inventory_transaction.notes %>
  </div>
</div>
