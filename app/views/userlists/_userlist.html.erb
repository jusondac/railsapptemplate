<div id="<%= dom_id userlist %>" class="w-full shadow-lg">
    <div class="bg-gray-800 text-white dark:bg-gray-900 shadow-lg px-4 py-2 font-bold">
        User Details
    </div>
    <div class="divide-y divide-gray-300 dark:divide-gray-700">
        <div class="flex odd:bg-gray-50 even:bg-gray-100 dark:odd:bg-gray-800 dark:even:bg-gray-700">
            <div class="w-1/3 text-left font-medium px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300">Username:</div>
            <div class="w-2/3 px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-900 dark:text-gray-100"><%= userlist.username %></div>
        </div>
        <div class="flex odd:bg-gray-50 even:bg-gray-100 dark:odd:bg-gray-800 dark:even:bg-gray-700">
            <div class="w-1/3 text-left font-medium px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300">Email:</div>
            <div class="w-2/3 px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-900 dark:text-gray-100"><%= userlist.email %></div>
        </div>
        <div class="flex odd:bg-gray-50 even:bg-gray-100 dark:odd:bg-gray-800 dark:even:bg-gray-700">
            <div class="w-1/3 text-left font-medium px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300">Address:</div>
            <div class="w-2/3 px-4 py-2 border-b border-gray-200 dark:border-gray-600 text-gray-900 dark:text-gray-100"><%= userlist.address %></div>
        </div>
    </div>
</div>