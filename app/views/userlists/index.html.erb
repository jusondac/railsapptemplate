<% content_for :title, "Userlists" %>
<div class="w-full bg-white dark:bg-gray-900 min-h-full pb-10">
  <div class="p-5 mt-10 bg-white dark:bg-gray-800 pt-10">
    <nav class="text-sm text-gray-600 dark:text-gray-400">
      <ol class="list-reset flex text-lg font-bold">
        <li>
          <%= link_to "Home" , root_path, class: "text-blue-600 hover:underline dark:text-blue-400" %>
        </li>
        <li><span class="mx-2">/</span></li>
        <li class="text-gray-700 dark:text-gray-300">User List</li>
      </ol>
      <div class="flex justify-between items-center mt-5 mb-6">
        <h1 class=" text-3xl font-semibold text-gray-800 dark:text-gray-200">All user</h1>
      </div>
    </nav>
    <div class="flex justify-between items-center">
      <div class="flex items-center mb-4 sm:mb-0">
        <%= search_form_for @q, html: { class: "sm:pr-3 flex gap-2" } do |f| %>
          <%= f.label :username_cont, class: "sr-only" %>
          <div class="relative w-48 mt-1 sm:w-64 xl:w-96">
            <%= f.search_field :username_cont, class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500", placeholder: "search for user" %>
          </div>
        <% end %>
        <div class="flex items-center w-full sm:justify-end">
          <div class="flex pl-2 space-x-1">
            <a href="#"
                      class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd"
                          d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
                          clip-rule="evenodd"></path>
              </svg>
            </a>
            <a href="#"
                      class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd"
                          d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                          clip-rule="evenodd"></path>
              </svg>
            </a>
            <a href="#"
                      class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd"
                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                          clip-rule="evenodd"></path>
              </svg>
            </a>
            <a href="#"
                      class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path
                          d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z">
                </path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div>
        <button onclick="location.reload()"
            class="px-4 py-2 bg-blue-600 text-white rounded-md shadow-md hover:bg-blue-500 inline-flex items-center">
          <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99">
            </path>
          </svg>
          Refresh
        </button>
        <%= render  ModalComponent.new(title: "add User", modal_id: "user_modal") do |component| %>
          <%= component.with_icon do %>
            <svg class="w-5 h-5 mr-2 -ml-1" fill="currentColor" viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
            </svg>
          <% end %>
          <%= component.with_form do %>
            <%= form_with model: Userlist.new, url: userlists_path, local: true do |f| %>
              <div class="mb-4">
                <%= f.label :username, "Username" ,
                      class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                <%= f.text_field :username, placeholder: "Enter username" ,
                        class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5"
                        %>
              </div>
              <div class="mb-4">
                <%= f.label :email, "Email" , class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                <%= f.email_field :email, placeholder: "Enter email" ,
                        class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5"
                        %>
              </div>
              <div class="mb-4">
                <%= f.label :address, "Address" ,
                      class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                <%= f.text_field :address, placeholder: "Enter address" ,
                        class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5"
                        %>
              </div>
              <hr class="my-5 border-gray-300 dark:border-gray-600">
              <div class="flex items-center space-x-2">
                <%= f.submit "Add User" ,
                      class: "px-4 py-2 bg-blue-600 text-white rounded-md shadow-md hover:bg-blue-500" %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <%= render "shared/components/crud_table" , thing: "user" , columns: Userlist.table_columns, datas: @userlists,
      pagy: @pagy, actions: [ { name: "Edit" , path: "userlist_path" , icon: "edit" }, { name: "Delete" ,
      path: "userlist_path" , icon: "trash" , method: :delete } ] %>
  <%= render "shared/components/pagination" , pagy: @pagy %>
  <%= render "shared/footer" %>
</div>