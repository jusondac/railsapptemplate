<%= form_with(model: inventory_transaction, class: "contents") do |form| %>
  <% if inventory_transaction.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(inventory_transaction.errors.count, "error") %> prohibited this inventory_transaction from being saved:</h2>

      <ul class="list-disc ml-6">
        <% inventory_transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :product_id %>
    <%= form.text_field :product_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": inventory_transaction.errors[:product_id].none?, "border-red-400 focus:outline-red-600": inventory_transaction.errors[:product_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :quantity_change %>
    <%= form.number_field :quantity_change, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": inventory_transaction.errors[:quantity_change].none?, "border-red-400 focus:outline-red-600": inventory_transaction.errors[:quantity_change].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :transaction_type %>
    <%= form.text_field :transaction_type, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": inventory_transaction.errors[:transaction_type].none?, "border-red-400 focus:outline-red-600": inventory_transaction.errors[:transaction_type].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :notes %>
    <%= form.textarea :notes, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": inventory_transaction.errors[:notes].none?, "border-red-400 focus:outline-red-600": inventory_transaction.errors[:notes].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
