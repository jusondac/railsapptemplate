<div id="<%= dom_id product_attribute %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Product:</strong>
    <%= product_attribute.product_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Attribute name:</strong>
    <%= product_attribute.attribute_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Attribute value:</strong>
    <%= product_attribute.attribute_value %>
  </div>
</div>
