<div class="flex items-center justify-center bg-gray-100 dark:bg-gray-900">
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 w-full max-w-md">
        <%= form_with(model: userlist, class: "contents") do |form| %>
        <% if userlist.errors.any? %>
        <div id="error_explanation" class="bg-red-50 dark:bg-red-900 text-red-500 dark:text-red-300 px-3 py-2 font-medium rounded-md mt-3">
            <h2><%= pluralize(userlist.errors.count, "error") %> prohibited this userlist from being saved:</h2>

            <ul class="list-disc ml-6">
                <% userlist.errors.each do |error| %>
                <li><%= error.full_message %></li>
                <% end %>
            </ul>
        </div>
        <% end %>

        <div class="my-5">
            <%= form.label :username, class: "text-gray-900 dark:text-gray-100" %>
            <%= form.text_field :username, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600 dark:border-gray-600 dark:focus:outline-blue-400": userlist.errors[:username].none?, "border-red-400 focus:outline-red-600 dark:border-red-600 dark:focus:outline-red-400": userlist.errors[:username].any?}] %>
        </div>

        <div class="my-5">
            <%= form.label :email, class: "text-gray-900 dark:text-gray-100" %>
            <%= form.text_field :email, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600 dark:border-gray-600 dark:focus:outline-blue-400": userlist.errors[:email].none?, "border-red-400 focus:outline-red-600 dark:border-red-600 dark:focus:outline-red-400": userlist.errors[:email].any?}] %>
        </div>

        <div class="my-5">
            <%= form.label :address, class: "text-gray-900 dark:text-gray-100" %>
            <%= form.text_field :address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600 dark:border-gray-600 dark:focus:outline-blue-400": userlist.errors[:address].none?, "border-red-400 focus:outline-red-600 dark:border-red-600 dark:focus:outline-red-400": userlist.errors[:address].any?}] %>
        </div>

        <div class="inline">
            <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 dark:bg-blue-700 dark:hover:bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
        </div>
        <% end %>
    </div>
</div>