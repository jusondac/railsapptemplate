<div class="container mx-auto pt-3 text-gray-100 h-screen">

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 h-3/4">
        <div class="md:col-span-2 p-4 border border-gray-700 rounded shadow bg-gray-800">
            <%= content_tag :div, "",
      id: "chart",
      data: {
        sales_labels: json_escape(@sales_data.keys.to_json),
        sales_values: @sales_data.values.to_json
      } %>

        </div>
        <div class="md:col-span-1 p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h2 class="font-semibold text-2xl text-gray-100">Narrow Card</h2>
            <p class="text-gray-400">This card spans one-third of the width.</p>
        </div>
    </section>
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h3 class="font-semibold text-xl text-gray-100">Feature 1</h3>
            <p class="text-gray-400">Description of the first feature.</p>
        </div>
        <div class="p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h3 class="font-semibold text-xl text-gray-100">Feature 2</h3>
            <p class="text-gray-400">Description of the second feature.</p>
        </div>
        <div class="p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h3 class="font-semibold text-xl text-gray-100">Feature 3</h3>
            <p class="text-gray-400">Description of the third feature.</p>
        </div>
    </section>
    <section class="grid mt-10 grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h2 class="font-semibold text-2xl text-gray-100">About Us</h2>
        </div>
        <div class="p-4 border border-gray-700 rounded shadow bg-gray-800">
            <h2 class="font-semibold text-2xl text-gray-100">Get Started</h2>
            <p class="text-gray-400">Explore the features of this application and get started today.</p>
        </div>
    </section>

    <%= render "shared/footer" %>
</div>