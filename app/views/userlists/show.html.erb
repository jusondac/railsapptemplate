<% content_for :title, "Showing userlist" %>

<div class="flex w-full min-h-full pt-10 bg-gray-100 dark:bg-gray-800">

    <div class="w-full">
        <h1 class="font-bold text-4xl text-gray-900 dark:text-gray-100 mb-4 m-5">Showing userlist</h1>

        <div class="mb-6">
            <%= render @userlist %>
        </div>

        <div class="flex flex-wrap gap-2 m-5">
            <%= render "shared/components/edit_modal", data: @userlist, title: "User", path: "edit_userlist_path", columns: Userlist.table_columns %>
            <%= render "shared/components/link_to", title: "Edit", path: edit_userlist_path(@userlist) do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline-block" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.414 2.586a2 2 0 010 2.828l-10 10a2 2 0 01-.707.414l-4 1a1 1 0 01-1.265-1.265l1-4a2 2 0 01.414-.707l10-10a2 2 0 012.828 0zM15.586 4L5.586 14H4v-1.586L14 3.586 15.586 4z" />
            </svg>
            <% end %>
            <%= link_to "Back to userlists", userlists_path, class: "w-full sm:w-auto text-center rounded-md px-4 py-2 bg-gray-500 hover:bg-gray-400 text-white font-medium" %>
            <%= button_to "Destroy this userlist", @userlist, method: :delete, form_class: "sm:inline-block", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
        </div>
    </div>
</div>