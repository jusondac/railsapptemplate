<div class="flex flex-col">
    <div class="overflow-x-auto">
        <div class="inline-block min-w-full align-middle">
            <div class="overflow-hidden shadow">
                <table class="min-w-full divide-y divide-gray-200 table-fixed dark:divide-gray-600">
                    <thead class="bg-gray-100 dark:bg-gray-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 uppercase dark:text-gray-300">
                                <input type="checkbox" id="select_all" class="form-checkbox h-4 w-4 text-blue-600 border-gray-300 rounded bg-gray-200 focus:ring focus:ring-blue-500 focus:ring-opacity-50 appearance-none">
                            </th>
                            <% columns.each do |column| %>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 uppercase dark:text-gray-300">
                                <%= column[:label] %>
                            </th>
                            <% end %>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 uppercase dark:text-gray-300">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                        <% datas.each do |data| %>
                        <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                            <td class="px-6 py-4">
                                <input type="checkbox" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" name="datalist_ids[]" value="<%= data.id %>">
                            </td>
                            <%= render partial: "shared/components/column_data", collection: columns, as: :column, locals: { data: data } %>

                            <td class="p-4 space-x-2 whitespace-nowrap">
                                <div class="flex items-center space-x-2">
                                    <button data-modal-target="editDataModal-<%= data.id %>" data-modal-toggle="editDataModal-<%= data.id %>" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-900">
                                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M15.232 4.768a1 1 0 00-1.414 0L4.768 13.232a1 1 0 00-.293.707V16a1 1 0 001 1h2.061a1 1 0 00.707-.293l9.05-9.05a1 1 0 000-1.414l-2.586-2.586zM6.414 14H5v-.414L13.586 5l1.414 1.414L6.414 14z" clip-rule="evenodd"></path>
                                        </svg>
                                        Edit
                                    </button>

                                    <div id="editDataModal-<%= data.id %>" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-modal md:h-full">
                                        <div class="relative w-full h-full max-w-2xl md:h-auto">
                                            <div class="relative dark:bg-gray-800 rounded-lg shadow dark:bg-gray-700">
                                                <div class="flex items-start justify-between p-4 border-b rounded-t dark:border-gray-600">
                                                    <h3 class="text-2xl font-semibold text-gray-900 dark:text-white">
                                                        Edit <%= thing %>
                                                    </h3>
                                                    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="editDataModal-<%= data.id %>">
                                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                                        </svg>
                                                    </button>
                                                </div>
                                                <div class="p-6 space-y-6">
                                                    <%= form_with model: data, url: send(actions.dig(0, :path), data), method: :patch, local: true do |f| %>
                                                    <div class="mb-4">
                                                        <%= f.label :username, "name", class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                                                        <%= f.text_field :username, value: data.username, class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5" %>
                                                    </div>
                                                    <div class="mb-4">
                                                        <%= f.label :email, "Email", class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                                                        <%= f.email_field :email, value: data.email, class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5" %>
                                                    </div>
                                                    <div class="mb-4">
                                                        <%= f.label :address, "Address", class: "block text-sm font-bold text-gray-700 dark:text-gray-300" %>
                                                        <%= f.text_field :address, value: data.address, class: "mt-1 block w-full rounded-md bg-gray-600 border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white p-2.5" %>
                                                    </div>
                                                    <hr class="my-5 border-gray-300 dark:border-gray-600">
                                                    <div class="flex items-center space-x-2">
                                                        <%= f.submit "Save Changes", class: "px-4 py-2 bg-blue-600 text-white rounded-md shadow-md hover:bg-blue-500" %>
                                                    </div>
                                                    <% end %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <%= button_to send(actions.dig(1, :path), data), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:focus:ring-red-900" do %>
                                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                    </svg>
                                    Delete
                                    <% end %>
                            </td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const selectAllCheckbox = document.getElementById("select_all");
            const checkboxes = document.querySelectorAll('input[name="datalist_ids[]"]');

            selectAllCheckbox.addEventListener("change", (e) => {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = e.target.checked;
                });
            });
        });
    </script>
</div>