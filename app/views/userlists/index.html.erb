<% content_for :title, "Userlists" %>

<div class="w-full space-y-6">
    <% if notice.present? %>
    <p class="py-3 px-4 bg-green-50 text-green-600 font-medium rounded-lg shadow-sm" id="notice"><%= notice %></p>
    <% end %>

    <div class="p-6 mt-5 bg-gray-100 dark:bg-gray-800 rounded-lg shadow-sm">
        <nav class="text-sm text-gray-600 dark:text-gray-400">
            <ol class="list-reset flex">
                <li>
                    <%= link_to "Home", root_path, class: "text-blue-600 hover:underline dark:text-blue-400" %>
                </li>
                <li><span class="mx-2">/</span></li>
                <li class="text-gray-700 dark:text-gray-300">User List</li>
            </ol>
        </nav>
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300">Page Information</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            This page displays a list of userlists. You can view, edit, or delete existing userlists, or create a new one using the button above.
        </p>
    </div>
    <div class="flex justify-between items-center">
        <h1 class="font-bold text-4xl">Userlists</h1>
        <%= link_to "New userlist", new_userlist_path, class: "rounded-lg px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium shadow-md" %>
    </div>

    <table id="userlists" class="w-full table-auto border border-gray-300 dark:border-gray-600 rounded-lg overflow-hidden shadow-sm">
        <thead>
            <tr class="bg-gray-50 dark:bg-gray-800">
                <% ["Username", "Email", "Address", "Actions"].each do |header| %>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 uppercase dark:text-gray-300"><%= header %></th>
                <% end %>
            </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-700">
            <% if @userlists.any? %>
            <% @userlists.each do |userlist| %>
            <tr>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"><%= userlist.username %></td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"><%= userlist.email %></td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"><%= userlist.address %></td>
                <td class="px-6 py-4">
                    <div class="flex space-x-2">
                        <%= link_to "Show", userlist, class: "text-sm px-3 py-2 bg-gray-100 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:text-gray-300 rounded-md shadow-md" %>
                        <%= link_to "Edit", edit_userlist_path(userlist), class: "text-sm px-3 py-2 bg-gray-100 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:text-gray-300 rounded-md shadow-md" %>
                        <%= button_to "Destroy", userlist, method: :delete, class: "text-sm px-3 py-2 text-white bg-red-600 hover:bg-red-500 dark:bg-red-700 dark:hover:bg-red-600 rounded-md shadow-md", data: { turbo_confirm: "Are you sure?" } %>
                    </div>
                </td>
            </tr>
            <% end %>
            <% else %>
            <tr>
                <td colspan="4" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">No userlists found.</td>
            </tr>
            <% end %>
        </tbody>
    </table>
    <div class="mt-5 w-full flex justify-center items-center">
        <%== pagy_nav(@pagy) %>
    </div>
</div>