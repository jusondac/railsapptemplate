<div id="<%= dom_id userlist %>" class="rounded lg:w-full sm:w-auto my-5 border border-gray-300 rounded-lg shadow-lg dark:border-gray-700">
    <div class="bg-gray-800 text-white dark:bg-gray-900 rounded-t-lg shadow-lg px-4 py-2 font-bold">
        User Details
    </div>
    <div class="divide-y divide-gray-300 dark:divide-gray-700">
        <div class="flex odd:bg-gray-100 even:bg-white dark:odd:bg-gray-800 dark:even:bg-gray-900">
            <div class="w-1/3 text-left font-medium px-4 py-2 border-b border-gray-300 dark:border-gray-700">Username:</div>
            <div class="w-2/3 px-4 py-2 border-b border-gray-300 dark:border-gray-700"><%= userlist.username %></div>
        </div>
        <div class="flex odd:bg-gray-100 even:bg-white dark:odd:bg-gray-800 dark:even:bg-gray-900">
            <div class="w-1/3 text-left font-medium px-4 py-2 border-b border-gray-300 dark:border-gray-700">Email:</div>
            <div class="w-2/3 px-4 py-2 border-b border-gray-300 dark:border-gray-700"><%= userlist.email %></div>
        </div>
        <div class="flex odd:bg-gray-100 even:bg-white dark:odd:bg-gray-800 dark:even:bg-gray-900">
            <div class="w-1/3 text-left font-medium px-4 py-2 dark:text-gray-300">Address:</div>
            <div class="w-2/3 px-4 py-2 dark:text-gray-300"><%= userlist.address %></div>
        </div>
    </div>
</div>