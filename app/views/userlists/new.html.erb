<% content_for :title, "New userlist" %>

<div class="w-full flex justify-center">
    <div class="w-full mt-6">
        <div class="card bg-gray-800 shadow-md rounded-lg p-6 mb-4 text-white">
            <h2 class="text-2xl font-semibold mb-2">New User</h2>
            <p class="text-gray-600">Fill out the form below to create a new user for the userlist.</p>
        </div>
        <h1 class="font-bold text-4xl text-center mb-5">New userlist</h1>

        <%= render "form", userlist: @userlist %>

        <div class="flex justify-center mt-4">
            <%= link_to "Back to userlists", userlists_path, class: "rounded-md px-3.5 py-2.5 bg-gray-800 text-white hover:bg-gray-700 inline-block font-medium" %>
        </div>
    </div>
</div>