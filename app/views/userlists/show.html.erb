<% content_for :title, "Showing userlist" %>

<div class="flex w-full -fit justify-center items-center p-20 bg-gray-100 dark:bg-gray-900">
    <div class="md:w-2/3 w-full">
        <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 dark:bg-green-900 mb-5 text-green-500 dark:text-green-300 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
        <% end %>

        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h1 class="font-bold text-4xl text-gray-900 dark:text-gray-100 mb-4">Showing userlist</h1>

            <div class="mb-6">
                <%= render @userlist %>
            </div>

            <div class="flex flex-wrap gap-2">
                <%= link_to "Edit this userlist", edit_userlist_path(@userlist), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 font-medium" %>
                <%= link_to "Back to userlists", userlists_path, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 font-medium" %>
                <%= button_to "Destroy this userlist", @userlist, method: :delete, form_class: "sm:inline-block", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
            </div>
        </div>
    </div>
</div>